{
  "name": "timeglide",
  "version": "1.0.0",
  "description": "Ultra-minimal, fast date selector timeline (vanilla JS)",
  "license": "MIT",
  "author": "TimeGlide contributors",
  "main": "dist/timglide.umd.js",
  "module": "dist/timglide.esm.js",
  "types": "types/timglide.d.ts",
  "scripts": {
    "screenshot": "node scripts/screenshot.js",
    "prepare:playwright": "npx playwright install --with-deps"
  },
  "exports": {
    ".": {
      "import": "./dist/timglide.esm.js",
      "default": "./dist/timglide.umd.js",
      "types": "./types/timglide.d.ts"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "date",
    "datepicker",
    "timeline",
    "vanilla-js",
    "component"
  ],
  "devDependencies": {
    "playwright": "^1.48.0"
  }
}
